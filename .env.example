# ── AI providers (server-side only — never expose to the client bundle) ──
SARVAM_API_KEY=sk_your_sarvam_key_here

# NOTE: a real key was accidentally committed to this file historically.
# ROTATE that key in the Sarvam dashboard and consider history scrubbed
# deploys. Never put real keys in this file; use your platform's secret
# store (Dokploy/Vercel env vars) instead.

# ── Email delivery (password reset + SOS alerts to trusted contacts) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Watchora <no-reply@watchora.app>
PUBLIC_APP_URL=http://localhost:5173

# ── SMS delivery for SOS alerts (Twilio; optional but recommended) ──
# When set, trusted contacts with a phone number get SOS alerts by SMS
# in addition to email. Without these, alerts are email-only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# DEV ONLY, NEVER set true in production: returns raw password-reset tokens
# in the /api/auth/forgot-password response for local testing convenience.
EXPOSE_DEV_RESET_TOKEN=false
