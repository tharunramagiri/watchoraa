generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BLIND_USER
  CAREGIVER
  ADMIN
}

enum SessionMode {
  NAVIGATION
  ASSISTANT
  READING
  ENVIRONMENT
  EMERGENCY
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssistanceStatus {
  PENDING
  SENT
  FAILED
  RESOLVED
}

enum ConsentScope {
  LOCATION_SHARING
  TRUSTED_CONTACTS
  EMERGENCY_ALERTS
  ACTIVITY_HISTORY
  READING_HISTORY
}

enum JourneyStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ESCALATED
}

enum EmergencyStatus {
  ACTIVE
  CANCELLED
  RESOLVED
  EXPIRED
}

enum IncidentStatus {
  OPEN
  REVIEWED
  REMOVED
}

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique
  passwordHash          String
  fullName              String
  preferredLanguage     String              @default("en")
  role                  UserRole            @default(BLIND_USER)
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  preferences           AccessibilityPrefs?
  trustedContacts       TrustedContact[]     @relation("UserTrustedContacts")
  journeys              Journey[]
  savedPlaces           SavedPlace[]
  readingEntries        ReadingEntry[]
  assistanceRequests    AssistanceRequest[]
  incidentsReported     IncidentReport[]     @relation("IncidentReporter")
  consentGrants         ConsentGrant[]
  auditLogs              AuditLog[]          @relation("AuditActor")
  passwordResets         PasswordReset[]
  refreshTokens          RefreshToken[]
  emergencySessions      EmergencySession[]
  taughtThings         TaughtThing[]
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  revokedAt         DateTime?
  replacedByTokenId String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AccessibilityPrefs {
  id                  String   @id @default(cuid())
  userId              String   @unique
  speechRate          Float    @default(1)
  voiceName           String?
  instructionDetail   Int      @default(2)
  vibrationEnabled    Boolean  @default(true)
  audioEnabled        Boolean  @default(true)
  reducedMotion       Boolean  @default(false)
  textScale           Float    @default(1)
  lowConnectivityMode Boolean  @default(true)
  imageRetentionHours Int      @default(0)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrustedContact {
  id               String   @id @default(cuid())
  userId           String
  name             String
  relationship     String?
  email            String?
  phone            String?
  canReceiveAlerts Boolean  @default(false)
  canSeeLocation   Boolean  @default(false)
  canSeeJourneys   Boolean  @default(false)
  shareExpiresAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation("UserTrustedContacts", fields: [userId], references: [id], onDelete: Cascade)
  monitoredJourneys Journey[] @relation("JourneyTrustedContact")

  @@index([userId])
  @@index([email])
}

model ConsentGrant {
  id          String       @id @default(cuid())
  userId      String
  scope       ConsentScope
  grantedAt   DateTime     @default(now())
  revokedAt   DateTime?
  metadata    Json?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedPlace {
  id          String   @id @default(cuid())
  userId      String
  label       String
  notes       String?
  latitude    Float?
  longitude   Float?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Journey {
  id            String       @id @default(cuid())
  userId        String
  destination   String
  mode          SessionMode
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  summary       String?
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Safe Journey (v0.3): safety monitoring fields
  status          JourneyStatus @default(ACTIVE)
  eta             DateTime?
  trustedContactId String?
  checkInIntervalMinutes Int @default(15)
  shareLive       Boolean   @default(false)
  deviationThresholdMeters Float @default(80)
  lastLat         Float?
  lastLng         Float?
  lastAccuracy    Float?
  lastBearing     Float?
  lastLocationAt  DateTime?
  lastCheckInAt   DateTime?
  lastPromptAt    DateTime?  // last "are you safe?" prompt to the user
  promptCount     Int       @default(0)
  escalatedAt     DateTime?
  locations       JourneyLocation[]
  trustedContact  TrustedContact? @relation("JourneyTrustedContact", fields: [trustedContactId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

model JourneyLocation {
  id         String   @id @default(cuid())
  journeyId  String
  lat        Float
  lng        Float
  accuracy   Float?
  heading    Float?
  speed      Float?
  battery    Float?
  recordedAt DateTime @default(now())
  journey    Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, recordedAt])
}

model EmergencySession {
  id          String   @id @default(cuid())
  userId      String
  status      EmergencyStatus @default(ACTIVE)
  triggeredAt DateTime @default(now())
  cancelledAt DateTime?
  resolvedAt  DateTime?
  expiresAt   DateTime?
  lat         Float?
  lng         Float?
  accuracy    Float?
  battery     Float?
  heading     Float?
  speed       Float?
  mapsUrl     String?
  journeyId   String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgements EmergencyAcknowledgement[]

  @@index([userId, triggeredAt])
}

model EmergencyAcknowledgement {
  id          String   @id @default(cuid())
  sessionId   String
  contactUserId String?
  acknowledgedAt DateTime @default(now())
  note        String?
  session     EmergencySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ReadingEntry {
  id            String   @id @default(cuid())
  userId        String
  source        String
  extractedText String
  language      String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AssistanceRequest {
  id              String            @id @default(cuid())
  userId          String
  contactId       String?
  message         String
  status          AssistanceStatus   @default(PENDING)
  locationShare   Boolean            @default(false)
  createdAt       DateTime           @default(now())
  sentAt          DateTime?
  resolvedAt      DateTime?
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model IncidentReport {
  id              String            @id @default(cuid())
  reporterId      String
  severity        IncidentSeverity   @default(MEDIUM)
  category        String
  description     String
  mode            SessionMode?
  status          IncidentStatus    @default(OPEN)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  reporter        User              @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([reporterId])
}

model TaughtThing {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, name])
}

model PromptVersion {
  id          String   @id @default(cuid())
  mode        SessionMode
  version     Int
  prompt      String
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([mode, version])
}

model AIRequestLog {
  id            String   @id @default(cuid())
  userId        String?
  mode          SessionMode
  provider      String
  model         String
  promptVersion Int?
  latencyMs     Int?
  success       Boolean  @default(true)
  redactedInput String?
  redactedOutput String?
  errorMessage  String?
  createdAt     DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
}
